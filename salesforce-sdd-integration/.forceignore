package.xml

# LWC configuration files
**/jsconfig.json
**/.eslintrc.json

# LWC Jest
**/__tests__/**

node_modules/

# Agentforce (Agent Script): la fuente es aiAuthoringBundles/*.agent y se publica con
# `sf agent publish authoring-bundle`. Bot y GenAiPlannerBundle los genera ese publish y no se pueden
# desplegar sobre un agente activo, así que se excluyen del deploy/retrieve por source.
**/bots/**
**/genAiPlannerBundles/**
